generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Auth {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  email             String         @unique
  password          String
  name              String
  role              UserRole
  status            UserStatus     @default(PENDING)
  loginProvider     LoginProvider
  fcmToken          String?
  timezone          String?
  /// bumped on password change/reset, block and delete: revokes every issued token
  tokenVersion      Int?
  /// set once the admin checklist templates were copied to this user
  checklistSeededAt DateTime?
  consent           Consent?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  otp               OTP?
  notifications     Notification[]
  symptoms          Symptom[]
  appointments      Appointment[]
  medications       Medication[]
  supplements       Supplement[]
  journals          Journal[]
  checklists        Checklist[]
  costs             Cost[]
  cycles            Cycle[]
  testResults       TestResult[]
  notes             Note[]
  questions         Question[]
  documents         Document[]
  photos            Photo[]
  subscription      Subscription?
  supports          Support[]
  payments          Payment[]
}

/// Choices from the app's "Your consent matters" screen (UK GDPR).
type Consent {
  healthData          Boolean
  healthDataUpdatedAt DateTime
  marketing           Boolean
  cookies             Boolean
  updatedAt           DateTime
}

model OTP {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  authId            String     @unique @db.ObjectId
  otp               String
  expires           DateTime
  attempts          Int        @default(0)
  isVerified        Boolean    @default(false)
  createdAt         DateTime   @default(now())
  purpose           OTPPurpose
  resetTokenExpires DateTime?
  resetTokenHash    String?
  auth              Auth       @relation(fields: [authId], references: [id])

  @@unique([authId, purpose])
}

model Symptom {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  authId      String      @db.ObjectId
  auth        Auth        @relation(fields: [authId], references: [id])
  moods       Mood[]
  symptomName SymptomName
  note        String?
  date        DateTime    @default(now())
}

model Appointment {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  authId      String     @db.ObjectId
  auth        Auth       @relation(fields: [authId], references: [id])
  doctor      String
  description String?
  date        DateTime
  time        String
  createdAt   DateTime   @default(now())
  questions   Question[]
}

model Medication {
  id                   String                @id @default(auto()) @map("_id") @db.ObjectId
  authId               String                @db.ObjectId
  auth                 Auth                  @relation(fields: [authId], references: [id])
  name                 String
  dose                 String
  frequency            String
  type                 String
  startDate            DateTime
  endDate              DateTime
  reminderTimes        String[] // "HH:mm" (24h) in the user's local timezone; push at each time
  createdAt            DateTime              @default(now())
  medicationChecklists MedicationChecklist[]
}

model MedicationChecklist {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  medicationId String     @db.ObjectId
  medication   Medication @relation(fields: [medicationId], references: [id])
  date         DateTime   @default(now())
}

model Supplement {
  id                   String                @id @default(auto()) @map("_id") @db.ObjectId
  authId               String                @db.ObjectId
  auth                 Auth                  @relation(fields: [authId], references: [id])
  name                 String
  dose                 String
  frequency            String
  type                 String
  startDate            DateTime
  endDate              DateTime
  createdAt            DateTime              @default(now())
  supplementChecklists SupplementChecklist[]
}

model SupplementChecklist {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  supplementId String     @db.ObjectId
  supplement   Supplement @relation(fields: [supplementId], references: [id])
  date         DateTime   @default(now())
}

model Journal {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  authId    String   @db.ObjectId
  auth      Auth     @relation(fields: [authId], references: [id])
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Checklist {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  authId      String            @db.ObjectId
  auth        Auth              @relation(fields: [authId], references: [id])
  title       String
  category    ChecklistCategory
  date        DateTime
  description String?
  status      ChecklistStatus   @default(PENDING)
  createdAt   DateTime          @default(now())
}

model Cost {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  authId      String       @db.ObjectId
  auth        Auth         @relation(fields: [authId], references: [id])
  amount      Float
  date        DateTime
  isPaid      Boolean
  ivfRound    CostIvfRound
  type        CostType
  category    CostCategory
  description String?
  createdAt   DateTime     @default(now())
}

model Cycle {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  authId       String    @db.ObjectId
  auth         Auth      @relation(fields: [authId], references: [id])
  startDate    DateTime // UTC midnight of the first day
  cyclePeriod  Int? // length in days; null = ongoing
  endDate      DateTime? // UTC midnight of the last day (inclusive); null = ongoing
  /// number of bleeding days (optional)
  periodLength Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([authId, startDate])
}

model TestResult {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  authId         String   @db.ObjectId
  auth           Auth     @relation(fields: [authId], references: [id])
  category       String?
  name           String
  date           DateTime
  value          String
  unit           String?
  note           String?
  /// optional PDF/JPG/PNG attached to the result
  attachmentUrl  String?
  attachmentName String?
  mimeType       String?
  createdAt      DateTime @default(now())
}

model Document {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  authId String   @db.ObjectId
  auth   Auth     @relation(fields: [authId], references: [id])
  date   DateTime
  note   String?
  file   String
}

model Photo {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  authId    String         @db.ObjectId
  auth      Auth           @relation(fields: [authId], references: [id])
  caption   String
  milestone PhotoMilestone
  date      DateTime
  file      String
  fileSize  Int
}

model Question {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  authId        String      @db.ObjectId
  auth          Auth        @relation(fields: [authId], references: [id])
  text          String
  appointmentId String      @db.ObjectId
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  createdAt     DateTime    @default(now())
}

model Note {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  authId      String   @db.ObjectId
  auth        Auth     @relation(fields: [authId], references: [id])
  title       String
  description String?
  date        DateTime
  tags        String[]
}

model Notification {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  receiverId  String                @db.ObjectId
  receiver    Auth                  @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  message     String
  description String?
  modelType   NotificationModelType
  referenceId String?               @db.ObjectId
  read        Boolean               @default(false)
  pushed      Boolean               @default(false)
  dedupeKey   String                @unique @default(uuid()) // fixed key for de-duplication; random when not needed
  createdAt   DateTime              @default(now())

  @@index([receiverId, read, createdAt])
  @@map("notifications")
}

enum NotificationModelType {
  ACCOUNT
  SUBSCRIPTION
  SUPPORT
  APPOINTMENT
  DIGEST
  MEDICATION
  SYSTEM
  // admin-only types
  NEW_USER
  NEW_SUBSCRIPTION
  SUBSCRIPTION_CANCELED
  PAYMENT_FAILED
  NEW_SUPPORT
}

model Legal {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  privacyPolicy  String
  termsCondition String
  aboutUs        String
  updatedAt      DateTime @updatedAt

  @@map("legal")
}

model Support {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  authId      String?       @db.ObjectId
  auth        Auth?         @relation(fields: [authId], references: [id])
  title       String
  description String
  status      SupportStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}

/// Admin-managed purchasable plan, mapped to a RevenueCat (store) product.
model Package {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  billingCycle        BillingCycle
  revenueCatProductId String         @unique
  entitlementId       String
  description         String[]
  price               Float
  currency            String         @default("gbp")
  isDeleted           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]

  @@index([isDeleted])
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

/// One per user; mirrors the user's RevenueCat entitlement state.
model Subscription {
  id                    String             @id @default(auto()) @map("_id") @db.ObjectId
  authId                String             @unique @db.ObjectId
  auth                  Auth               @relation(fields: [authId], references: [id])
  packageId             String?            @db.ObjectId
  package               Package?           @relation(fields: [packageId], references: [id])
  revenueCatAppUserId   String
  productId             String?
  entitlementId         String?
  store                 String?
  /// SANDBOX | PRODUCTION
  environment           String?
  originalTransactionId String?
  latestTransactionId   String?
  lastEventId           String?
  status                SubscriptionStatus
  cancelAtPeriodEnd     Boolean            @default(false)
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelledAt           DateTime?
  managementUrl         String?
  rawEventData          Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

/// One record per store transaction (from RevenueCat webhook events).
model Payment {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  authId            String?       @db.ObjectId
  auth              Auth?         @relation(fields: [authId], references: [id])
  transactionId     String        @unique
  store             String?
  productId         String?
  packageId         String?       @db.ObjectId
  eventType         String?
  /// SANDBOX | PRODUCTION
  environment       String?
  amount            Float // major units (e.g. 9.99)
  amountRefunded    Float         @default(0)
  /// amount / amountRefunded converted to GBP (the reporting currency); null = unknown currency
  amountGbp         Float?
  amountRefundedGbp Float?
  currency          String
  status            PaymentStatus
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Single document: contact & community links shown in the app.
model AppSetting {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  supportEmail  String
  supportPhone  String
  communityLink String
  updatedAt     DateTime @updatedAt

  @@map("app_settings")
}

model Quote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  author    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, createdAt])
}

/// Admin-managed default items of the pre-treatment IVF checklist.
model ChecklistTemplate {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  category  ChecklistCategory
  title     String
  order     Int
  createdAt DateTime          @default(now())

  @@index([category, order])
}

enum SubscriptionStatus {
  ACTIVE
  /// entitlement lost because of a billing problem (recoverable)
  BILLING_ISSUE
  /// refunded / revoked
  CANCELLED
  EXPIRED
}

enum SupportStatus {
  PENDING
  RESOLVED
}

enum PhotoMilestone {
  CONSULTATION
  STIMS
  TRIGGER
  EGG_RETRIEVAL
  HAPPY_MOMENTS
  OTHER
}

enum CostCategory {
  CONSULTATION
  MEDICATION
  MONITORING
  EGG_RETRIEVAL
  EMBRYO_TRANSFER
  LAB_AND_GENETIC_TEST
  STORAGE_AND_FREEZING
  TRAVEL
  DEPOSIT
  OTHER
}

enum CostType {
  ONE_OFF
  PACKAGE
  DEPOSIT
}

enum CostIvfRound {
  ROUND_1
  ROUND_2
  ROUND_3
  ROUND_4
  ROUND_5
  ROUND_6
  ROUND_7
  ROUND_8
  ROUND_9
  ROUND_10
  UNSURE
}

enum ChecklistStatus {
  PENDING
  COMPLETED
}

enum ChecklistCategory {
  MEDICAL
  FINANCIAL
  LIFESTYLE
  WELLBEING
  PARTNER
  LOGISTIC
}

enum Mood {
  HAPPY
  CALM
  NEUTRAL
  SAD
  ANXIOUS
}

enum SymptomName {
  BLOATING
  FATIGUE
  HEADACHE
  NAUSEA
  BREAST_TENDERNESS
  CRAMPING
  OTHER
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  DELETED
}

enum LoginProvider {
  FACEBOOK
  GOOGLE
  EMAIL
}

enum OTPPurpose {
  VERIFY_ACCOUNT
  RESET_PASSWORD
}
