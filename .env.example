# development | production (docker compose always sets production)
NODE_ENV=
DATABASE_URL=
# defaults to 5003
PORT=
# proxies allowed to set X-Forwarded-For (Express "trust proxy"); default: loopback
TRUST_PROXY=

# admin data
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AWS S3 (uploads); leave the keys empty to use an IAM role / the default credential chain
S3_BUCKET_ACCESS_KEY=
S3_BUCKET_SECRET_ACCESS_KEY=
S3_BASE_URL=
S3_API=
AWS_REGION=
AWS_BUCKET_NAME=

# email
SEND_EMAIL_URL=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=

# RevenueCat (REST API secret key + webhook Authorization header value)
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# ========================================
#  Firebase Configuration (service account JSON)
#  Only PROJECT_ID, CLIENT_EMAIL and PRIVATE_KEY are used for push.
#  PRIVATE_KEY: keep the \n sequences and wrap the value in double quotes.
# ========================================
FIREBASE_ACCOUNT_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=
FIREBASE_CLIENT_EMAIL=